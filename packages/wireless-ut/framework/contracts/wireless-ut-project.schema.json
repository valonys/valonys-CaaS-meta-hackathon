{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valonys.example/schemas/wireless-ut-project.schema.json",
  "title": "Wireless UT project definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "title",
    "status",
    "source_role",
    "planning_basis",
    "runtime_data",
    "assumption_claim_ids",
    "assurance_boundaries"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "project_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["planning", "site_verification", "approved", "active", "closed"] },
    "source_role": { "const": "background_research_only" },
    "planning_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["circuits_min", "circuits_max", "locations_min", "locations_max", "duration_months_approx", "monitored_operation_months_min"],
      "properties": {
        "circuits_min": { "type": "integer", "minimum": 1 },
        "circuits_max": { "type": "integer", "minimum": 1 },
        "locations_min": { "type": "integer", "minimum": 1 },
        "locations_max": { "type": "integer", "minimum": 1 },
        "duration_months_approx": { "type": "number", "exclusiveMinimum": 0 },
        "monitored_operation_months_min": { "type": "number", "minimum": 0 }
      }
    },
    "runtime_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "measurement_records", "site_verified"],
      "properties": {
        "status": { "enum": ["not_provided", "synthetic", "replay", "live"] },
        "measurement_records": { "type": "integer", "minimum": 0 },
        "site_verified": { "type": "boolean" }
      }
    },
    "assumption_claim_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^CLM-[0-9]{3}$" }
    },
    "assurance_boundaries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "no_image_derived_thickness",
          "no_model_derived_measurement",
          "no_full_wall_inference_from_point_sensor",
          "no_inspection_replacement",
          "no_autonomous_ffs_or_continued_operation",
          "engineer_approval_required"
        ]
      }
    }
  }
}
